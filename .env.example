# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- App ----
# Public URL of this deployment (no trailing slash). Used in push links, invite links, Telegram deep links.
NEXT_PUBLIC_APP_URL=https://loyalty.yourdomain.com
# Random 32+ char secret for signing customer/staff session cookies: `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string
# Shared secret that n8n / Vercel Cron must send as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=change-me-too

# Enable only after approved SMS setup and isolated end-to-end tests. See docs/SMS-VERIFICATION.md.
# Customer access stays closed while disabled; there is no unverified login fallback.
CUSTOMER_PHONE_OTP_ENABLED=false
# Unset defaults to supabase (requires Supabase phone provider configuration).
# Direct Twilio Verify does not create Supabase Auth phone users.
CUSTOMER_PHONE_OTP_PROVIDER=supabase
# Preview/UAT only: CUSTOMER_PHONE_OTP_PROVIDER=dev with a fixed 6-digit code. No SMS is sent; refused on Vercel production.
CUSTOMER_PHONE_OTP_DEV_CODE=
# Server-only secrets; never prefix with NEXT_PUBLIC_. Use a separate StampOS Verify service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Direct Twilio: Singapore-local-day send-attempt cap (positive integer). Also fixed 30/service/hour.
# Counts reservations including failed/uncertain sends; NOT a guaranteed dollar-spend cap.
CUSTOMER_PHONE_OTP_DAILY_SEND_LIMIT=100
# Automatic marketing stays off until separately approved and tested.
AUTOMATIC_NUDGES_ENABLED=false

# ---- Web push (run `npm run vapid` to generate) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@yourdomain.com

# ---- Telegram (optional secondary channel) ----
# Create a bot with @BotFather, paste the token, then set the webhook:
# curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<NEXT_PUBLIC_APP_URL>/api/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---- WhatsApp (optional, Meta Cloud API) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
