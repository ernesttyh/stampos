# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---- App ----
# Public URL of this deployment (no trailing slash). Used in push links, invite links, Telegram deep links.
NEXT_PUBLIC_APP_URL=https://loyalty.yourdomain.com
# Random 32+ char secret for signing customer/staff session cookies: `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string
# Shared secret that n8n / Vercel Cron must send as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=change-me-too

# ---- Web push (run `npm run vapid` to generate) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@yourdomain.com

# ---- Telegram (optional secondary channel) ----
# Create a bot with @BotFather, paste the token, then set the webhook:
# curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<NEXT_PUBLIC_APP_URL>/api/telegram/webhook&secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---- WhatsApp (optional, Meta Cloud API) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
